# Copy this file to backend/.env. Keep real API keys out of the extension and do not share them.
# Base URL for an OpenAI-compatible endpoint, usually ending in /v1.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# Enter a model name available on your account. Leave blank to disable LLM analysis.
# Local checks continue to work when LLM analysis is disabled.
LLM_MODEL=
# Use max_completion_tokens instead if required by your model.
LLM_TOKEN_PARAMETER=max_tokens
LINK_LENS_PORT=43187

# Example for a local OpenAI-compatible service. Set the model name yourself.
# LLM_BASE_URL=http://127.0.0.1:11434/v1
